#!/bin/bash

#=================================================
# GENERIC START
#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

# Get the port from YunoHost resources
port=$(ynh_app_setting_get --app=$app --key=port)

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression --message="Ensuring downward compatibility..." --weight=1

upgrade_type=$(ynh_check_app_version_changed)

#=================================================
# NGINX CONFIGURATION
#=================================================
ynh_script_progression --message="Upgrading NGINX web server configuration..." --weight=2

# Create a dedicated NGINX config
ynh_add_nginx_config

#=================================================
# SPECIFIC UPGRADE
#=================================================
# CONFIGURE AND UPGRADE COUCHDB
#=================================================

if [ "$upgrade_type" == "UPGRADE_APP" ]
then
	ynh_script_progression --message="Upgrading CouchDB..." --weight=50

	# Preseed debconf before upgrade
	echo "\
	couchdb couchdb/mode select standalone
	couchdb couchdb/mode seen true
	couchdb couchdb/bindaddress string 127.0.0.1
	couchdb couchdb/bindaddress seen true
	couchdb couchdb/cookie string $password
	couchdb couchdb/adminpass password $password
	couchdb couchdb/adminpass seen true
	couchdb couchdb/adminpass_again password $password
	couchdb couchdb/adminpass_again seen true" | debconf-set-selections

	# Install/upgrade CouchDB from external repository
	ynh_install_extra_app_dependencies \
		--repo="deb https://apache.jfrog.io/artifactory/couchdb-deb/ $(lsb_release -c -s) main" \
		--key="https://couchdb.apache.org/repo/keys.asc" \
		--package="couchdb"
fi

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression --message="Updating a configuration file..." --weight=1

ynh_add_config --template="../conf/couch_ynh.ini" --destination="/opt/couchdb/etc/local.d/couch_ynh.ini"

# The permissions will be handled by CouchDB package installation
# Just ensure the config file has correct permissions
chmod 644 "/opt/couchdb/etc/local.d/couch_ynh.ini"

#=================================================
# RESTART COUCHDB SERVICE
#=================================================
ynh_script_progression --message="Restarting CouchDB service..." --weight=1

# Restart CouchDB to apply configuration changes
ynh_systemd_action --service_name=couchdb --action="restart" --log_path="/var/log/couchdb/couchdb.log"

#=================================================
# ENSURE COUCHDB SYSTEM DATABASES EXIST
#=================================================
ynh_script_progression --message="Checking CouchDB system databases..." --weight=2

# Wait for CouchDB to be fully started after restart
max_attempts=30
attempt=0
while [ $attempt -lt $max_attempts ]; do
    if curl -s -f --user "admin:$password" "http://127.0.0.1:$port/" >/dev/null 2>&1; then
        break
    fi
    ynh_print_info --message="Waiting for CouchDB to start... (attempt $((attempt + 1))/$max_attempts)"
    sleep 2
    attempt=$((attempt + 1))
done

if [ $attempt -eq $max_attempts ]; then
    ynh_print_warn --message="CouchDB did not start within expected time, skipping database check"
else
    # Check if system databases exist, create if missing
    for db in _users _replicator _global_changes; do
        if ! curl -s -f --user "admin:$password" "http://127.0.0.1:$port/$db" >/dev/null 2>&1; then
            ynh_print_info --message="Creating missing system database: $db"
            curl -X PUT --user "admin:$password" "http://127.0.0.1:$port/$db" -H "Content-Type: application/json" >/dev/null 2>&1 || ynh_print_warn --message="Failed to create $db database"
        fi
    done

    # Verify databases exist
    sleep 2
    missing_dbs=""
    for db in _users _replicator _global_changes; do
        if ! curl -s --user "admin:$password" "http://127.0.0.1:$port/$db" | grep -q "\"db_name\":\"$db\""; then
            missing_dbs="$missing_dbs $db"
        fi
    done

    if [ -z "$missing_dbs" ]; then
        ynh_print_info --message="✅ All CouchDB system databases are present"
    else
        ynh_print_warn --message="⚠️  Missing system databases:$missing_dbs"
    fi
fi

#=================================================
# GENERIC FINALIZATION
#=================================================
# SETUP LOGROTATE
#=================================================
ynh_script_progression --message="Upgrading logrotate configuration..." --weight=1

# Use logrotate to manage app-specific logfile(s)
ynh_use_logrotate --non-append

#=================================================
# INTEGRATE SERVICE IN YUNOHOST
#=================================================
ynh_script_progression --message="Integrating service in YunoHost..." --weight=2

yunohost service add $app --description="Open-source document-oriented NoSQL database" --log="/var/log/couchdb/couchdb.log" --needs_exposed_ports "$port"

#=================================================
# UPGRADE FAIL2BAN
#=================================================
ynh_script_progression --message="Reconfiguring Fail2Ban..." --weight=3

# Create a dedicated Fail2Ban config
ynh_add_fail2ban_config --logpath="/var/log/couchdb/couchdb.log" --failregex="[warning] .*couch_httpd_auth: Authentication failed for user .+ from <HOST>" --max_retry=5

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression --message="Upgrade of $app completed" --last
